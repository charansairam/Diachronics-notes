filters:
  and:
    - 'file.created != null'
    - 'file.path.endsWith(".md")'
    - 'file.name != "index"'
    - 'file.name != "404"'
    - '!file.inFolder("References")'
    - '!file.inFolder("tags")'
views:
  - type: table
    name: Pages
    order:
      - file.name
      - file.created
      - file.modified
      - file.tags
    sort:
      - property: file.tags
        direction: ASC
      - property: file.created
        direction: ASC
    columnSize:
      file.name: 309
      file.created: 145
      file.modified: 144
