filters:
  and:
    - 'file.ctime != null'
    - 'file.path.endsWith(".md")'
    - 'file.name != "index"'
    - 'file.name != "404"'
    - '!file.inFolder("References")'
    - '!file.inFolder("tags")'
views:
  - type: table
    name: Pages
    order:
      - file.name
      - file.ctime
      - file.mtime
      - file.tags
    sort:
      - property: file.tags
        direction: ASC
      - property: file.ctime
        direction: ASC
    columnSize:
      file.name: 309
      file.ctime: 145
      file.mtime: 144
