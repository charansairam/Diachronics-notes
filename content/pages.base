filters:
  and:
    - file.ctime != null
    - file.path.endsWith(".md")
    - file.basename != "index"
    - file.basename != "404"
    - '!file.inFolder("References")'
    - '!file.inFolder("tags")'
views:
  - type: table
    name: Pages
    filters:
      and:
        - file.ext == "md"
        - '!file.hasTag("index")'
    order:
      - file.name
      - file.ctime
      - file.mtime
      - file.tags
    sort:
      - property: file.ctime
        direction: DESC
      - property: file.tags
        direction: ASC
    columnSize:
      file.name: 309
      file.ctime: 145
      file.mtime: 144
